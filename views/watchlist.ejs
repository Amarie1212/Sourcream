<!DOCTYPE html>
<html lang="id">
<head>
  <title><%= site_title %></title>
  <%- include('partials/head'); %>
</head>
<body class="min-h-screen bg-[#EAE7DE] font-sans text-black dark:bg-[#111216] dark:text-white">
  <%- include('partials/header'); %>
  <main class="mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 py-6 sm:px-8">
    <section class="rounded-3xl border-2 border-black bg-white p-5 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] dark:border-white/20 dark:bg-[#181920] dark:shadow-[6px_6px_0px_0px_rgba(255,255,255,0.15)] sm:p-6">
      <div class="border-b-2 border-black/10 pb-5 dark:border-white/10">
        <h1 class="mt-1 text-3xl font-black uppercase sm:text-4xl">Watchlist</h1>
        <p class="mt-2 text-sm font-semibold text-neutral-600 dark:text-neutral-400">Filter anime by watch status.</p>
      </div>

      <div class="mt-5 rounded-2xl border-2 border-black bg-[#F5F3EF] p-4 dark:border-white/15 dark:bg-[#111216]" aria-label="Filter status watchlist">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <p class="text-xs font-black uppercase">Status filter</p>
            <p id="watchlistFilterSummary" class="mt-1 text-xs font-semibold text-neutral-600 dark:text-neutral-400">Showing all anime</p>
          </div>
          <span id="watchlistVisibleCount" class="rounded-full border-2 border-black bg-white px-3 py-1 text-[10px] font-black uppercase dark:border-white/20 dark:bg-[#181920]"><%= data.length %> anime</span>
        </div>
        <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Pilih status anime">
          <button type="button" data-watchlist-filter="all" aria-pressed="true" class="watchlist-filter inline-flex items-center gap-1.5 rounded-xl border-2 border-black bg-[#FACC15] px-3 py-2 text-[10px] font-black uppercase text-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all dark:border-white/20 dark:shadow-[2px_2px_0px_0px_rgba(255,255,255,0.2)]"><span data-filter-check aria-hidden="true">✓</span> Semua</button>
          <button type="button" data-watchlist-filter="planned" aria-pressed="false" class="watchlist-filter inline-flex items-center gap-1.5 rounded-xl border-2 border-black bg-white px-3 py-2 text-[10px] font-black uppercase transition-all hover:border-[#FACC15] hover:bg-[#FACC15] hover:text-black dark:border-white/20 dark:bg-[#181920]"><span data-filter-check aria-hidden="true" class="hidden">✓</span> Planned</button>
          <button type="button" data-watchlist-filter="watching" aria-pressed="false" class="watchlist-filter inline-flex items-center gap-1.5 rounded-xl border-2 border-black bg-white px-3 py-2 text-[10px] font-black uppercase transition-all hover:border-[#FACC15] hover:bg-[#FACC15] hover:text-black dark:border-white/20 dark:bg-[#181920]"><span data-filter-check aria-hidden="true" class="hidden">✓</span> On Watch</button>
          <button type="button" data-watchlist-filter="watched" aria-pressed="false" class="watchlist-filter inline-flex items-center gap-1.5 rounded-xl border-2 border-black bg-white px-3 py-2 text-[10px] font-black uppercase transition-all hover:border-[#FACC15] hover:bg-[#FACC15] hover:text-black dark:border-white/20 dark:bg-[#181920]"><span data-filter-check aria-hidden="true" class="hidden">✓</span> Watched</button>
          <button type="button" data-watchlist-filter="on_hold" aria-pressed="false" class="watchlist-filter inline-flex items-center gap-1.5 rounded-xl border-2 border-black bg-white px-3 py-2 text-[10px] font-black uppercase transition-all hover:border-[#FACC15] hover:bg-[#FACC15] hover:text-black dark:border-white/20 dark:bg-[#181920]"><span data-filter-check aria-hidden="true" class="hidden">✓</span> On hold</button>
          <button type="button" data-watchlist-filter="dropped" aria-pressed="false" class="watchlist-filter inline-flex items-center gap-1.5 rounded-xl border-2 border-black bg-white px-3 py-2 text-[10px] font-black uppercase transition-all hover:border-[#FACC15] hover:bg-[#FACC15] hover:text-black dark:border-white/20 dark:bg-[#181920]"><span data-filter-check aria-hidden="true" class="hidden">✓</span> Dropped</button>
        </div>
      </div>

      <% if (data.length) { %>
        <div id="watchlistGrid" class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-5">
          <% data.forEach(item => { %>
            <a href="/anime/<%= item.anime_slug %>" data-watchlist-item data-watchlist-status="<%= item.status || 'planned' %>" class="group overflow-hidden rounded-2xl border-2 border-black/20 bg-[#F5F3EF] transition-all hover:-translate-y-1 hover:border-[#D6A800] hover:shadow-[4px_4px_0px_0px_rgba(214,168,0,0.5)] dark:border-white/15 dark:bg-[#111216] dark:hover:border-[#FACC15] dark:hover:shadow-[4px_4px_0px_0px_rgba(250,204,21,0.45)]">
              <div class="aspect-[3/4] bg-neutral-300 dark:bg-neutral-800"><img src="<%= item.image || '/assets/images/no-img.jpg' %>" alt="<%= item.title %>" class="h-full w-full object-cover" onerror="this.src='/assets/images/no-img.jpg'"></div>
              <h2 class="p-3 pb-1 text-xs font-bold leading-snug group-hover:text-[#D6A800] dark:group-hover:text-[#FACC15]"><%= item.title %></h2>
              <p class="watchlist-card-status status-<%= item.status || 'planned' %> px-3 pb-1 text-[10px] font-black uppercase"><%= ({ planned: 'Planned', watching: 'On Watch', watched: 'Watched', on_hold: 'On Hold', dropped: 'Dropped' }[item.status] || 'Planned') %></p>
              <p class="px-3 pb-3 text-[10px] font-black uppercase text-neutral-500 dark:text-neutral-400"><%= item.progressEpisode ? `Up to episode ${item.progressEpisode}` : 'Not watched yet' %></p>
            </a>
          <% }) %>
        </div>
        <p id="watchlistFilteredEmpty" class="hidden py-16 text-center text-sm font-bold text-neutral-500 dark:text-neutral-400">No anime has this status.</p>
      <% } else { %>
        <p class="py-16 text-center text-sm font-bold text-neutral-500 dark:text-neutral-400">Your watchlist is empty.</p>
      <% } %>
    </section>
  </main>
  <%- include('partials/script'); %>
</body>
</html>
