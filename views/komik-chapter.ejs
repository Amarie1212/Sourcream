<!DOCTYPE html>
<html lang="id">
<head>
    <title><%= site_title %></title>
    <meta name="description" content="<%= site_desc %>">
    <meta name="keywords" content="<%= site_keyword %>">
    <meta property="og:title" content="<%= site_title %>">
    <meta property="og:description" content="<%= site_desc %>">
    <meta property="og:url" content="https://<%= site_url %>">
    <meta property="og:image" content="https://<%= site_url %>/assets/images/og.png">

    <%- include('partials/head'); %>
	<style>
		.neo-card {
			transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		}
		.neo-card:hover {
			transform: translateY(-3px);
			box-shadow: 4px 4px 0px 0px rgba(0, 0, 0, 1);
		}
		.dark .neo-card:hover {
			box-shadow: 4px 4px 0px 0px rgba(245, 158, 11, 0.35);
		}
	</style>
</head>
<body class="bg-[#EAE7DE] dark:bg-[#111216] text-black dark:text-white min-h-screen flex flex-col font-sans">
    <%- include('partials/header-komik'); %>

	<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-4 md:py-6 flex flex-col gap-6">
		
		<!-- BREADCRUMB & BACK DIRECTORY BAR (File Explorer Style) -->
		<div class="w-full flex items-center justify-between gap-2.5 bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 px-3 sm:px-4 py-2 sm:py-2.5 rounded-2xl shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] dark:shadow-[3px_3px_0px_0px_rgba(255,255,255,0.15)] text-xs font-bold">
			
			<!-- Left: Back Button & Path -->
			<div class="flex items-center gap-2 sm:gap-2.5 min-w-0 flex-1">
				
				<!-- Back Button -->
				<button onclick="goBack('<%= typeof comicSlug !== 'undefined' && comicSlug ? ('/komik/detail/' + comicSlug) : '/komik' %>')" 
						class="flex-shrink-0 inline-flex items-center gap-1.5 px-3 sm:px-4 py-1.5 rounded-full bg-[#F5F3EF] dark:bg-[#181920] hover:bg-[#FACC15] hover:text-black hover:border-black dark:hover:bg-[#FACC15] dark:hover:text-black dark:hover:border-black text-black dark:text-white border-2 border-black dark:border-white shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] dark:shadow-[1.5px_1.5px_0px_0px_rgba(255,255,255,0.25)] transition-colors font-black uppercase text-[10px] sm:text-xs tracking-wider cursor-pointer">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5">
					  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
					</svg>
					<span>Kembali</span>
				</button>

				<span class="text-neutral-300 dark:text-neutral-700 select-none flex-shrink-0">|</span>

				<!-- Explorer Path -->
				<nav aria-label="Directory Path" class="flex items-center gap-1 sm:gap-1.5 text-neutral-600 dark:text-neutral-400 font-mono text-[10px] sm:text-xs overflow-x-auto no-scrollbar py-0.5 min-w-0 flex-1 whitespace-nowrap">
					<a href="/" class="flex items-center gap-1 sm:gap-1.5 hover:text-black dark:hover:text-white transition-colors flex-shrink-0 font-bold">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5 text-amber-500 flex-shrink-0">
						  <path d="M2 4.75C2 3.784 2.784 3 3.75 3h4.836c.464 0 .909.184 1.237.513l1.414 1.414a.25.25 0 0 0 .177.073h4.836c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0 1 16.25 17H3.75A1.75 1.75 0 0 1 2 15.25V4.75Z" />
						</svg>
						<span>main</span>
					</a>
					
					<span class="text-neutral-400 select-none flex-shrink-0">/</span>
					
					<a href="/komik" class="hover:text-black dark:hover:text-white transition-colors flex-shrink-0 font-bold">
						komik
					</a>
					
					<span class="text-neutral-400 select-none flex-shrink-0">/</span>

					<% if (typeof comicSlug !== 'undefined' && comicSlug) { %>
						<a href="/komik/detail/<%= comicSlug %>" class="hover:text-amber-500 transition-colors truncate max-w-[80px] sm:max-w-[200px] flex-shrink-0 font-bold" title="<%= typeof comicTitle !== 'undefined' && comicTitle ? comicTitle : comicSlug %>">
							<%= typeof comicTitle !== 'undefined' && comicTitle ? comicTitle : comicSlug %>
						</a>
						<span class="text-neutral-400 select-none flex-shrink-0">/</span>
					<% } %>

					<span class="text-black dark:text-[#FACC15] font-black truncate max-w-[110px] sm:max-w-[320px] flex-shrink-0 bg-black/5 dark:bg-white/5 px-1.5 sm:px-2 py-0.5 rounded border border-black/10 dark:border-white/10">
						<%= site_title.replace(/\|\s*komik/i, '').trim() %>
					</span>
				</nav>

			</div>

		</div>

		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
			
			<!-- MAIN READER AREA (Left - 8 cols on lg) -->
			<article class="lg:col-span-8 flex flex-col gap-6">
				
				<!-- Reader Header Info Card -->
				<div class="w-full bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-3xl p-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,0.15)] flex flex-col gap-4">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<div class="flex items-center gap-2">
							<span class="px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase bg-amber-400 text-black border border-black shadow-xs">
								📖 MANGA READER
							</span>
							<span class="px-2.5 py-0.5 rounded-md text-[10px] font-bold bg-neutral-200 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200">
								<%= data ? data.length : 0 %> Halaman
							</span>
						</div>
					</div>

					<h1 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-black dark:text-white leading-snug">
						<%= site_title.replace('| Komik', '') %>
					</h1>

					<p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400">
						Scroll ke bawah untuk membaca seluruh halaman secara vertikal.
					</p>
				</div>

				<!-- Top Chapter Navigation Bar -->
				<div class="w-full flex items-center justify-between px-2.5 sm:px-5 py-2 sm:py-3 bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-2xl sm:rounded-3xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,0.15)] gap-1.5 sm:gap-3">
					
					<!-- Prev Chapter Button -->
					<% if (typeof prevChapter !== 'undefined' && prevChapter) { %>
						<a href="/komik/chapter/<%= prevChapter %>" class="flex-1 min-w-0 sm:flex-none inline-flex items-center justify-center gap-1 sm:gap-2 px-2.5 sm:px-5 py-2 sm:py-2.5 rounded-full bg-[#F5F3EF] dark:bg-[#181920] hover:bg-[#FACC15] hover:text-black hover:border-black dark:hover:bg-[#FACC15] dark:hover:text-black dark:hover:border-black text-black dark:text-white font-black text-xs sm:text-sm uppercase tracking-tight sm:tracking-wider border-2 border-black dark:border-white shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] dark:shadow-[1.5px_1.5px_0px_0px_rgba(255,255,255,0.25)] transition-colors cursor-pointer whitespace-nowrap" title="Chapter Sebelumnya">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 flex-shrink-0">
							  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
							</svg>
							<span class="hidden sm:inline">Sebelumnya</span>
						</a>
					<% } else { %>
						<span class="flex-1 min-w-0 sm:flex-none inline-flex items-center justify-center gap-1 sm:gap-2 px-2.5 sm:px-5 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-black uppercase tracking-tight sm:tracking-wider text-neutral-400 dark:text-neutral-500 bg-neutral-100 dark:bg-[#121317] border-2 border-neutral-300 dark:border-neutral-700/80 cursor-not-allowed opacity-60 whitespace-nowrap">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 flex-shrink-0">
							  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
							</svg>
							<span class="hidden sm:inline">Sebelumnya</span>
						</span>
					<% } %>

					<!-- Daftar Chapter Center Button -->
					<a href="/komik/detail/<%= typeof comicSlug !== 'undefined' && comicSlug ? comicSlug : '' %>" class="flex-shrink-0 inline-flex items-center justify-center gap-1.5 sm:gap-2 w-9 h-9 sm:w-auto sm:h-auto sm:px-4 sm:py-2.5 rounded-full bg-[#F5F3EF] dark:bg-[#181920] hover:bg-[#FACC15] hover:text-black hover:border-black dark:hover:bg-[#FACC15] dark:hover:text-black dark:hover:border-black text-black dark:text-white border-2 border-black dark:border-white shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] dark:shadow-[1.5px_1.5px_0px_0px_rgba(255,255,255,0.25)] transition-colors cursor-pointer whitespace-nowrap" title="Daftar Chapter">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 flex-shrink-0 text-[#FACC15]">
							<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
						</svg>
						<span class="hidden sm:inline text-xs sm:text-sm font-black uppercase tracking-wider">Daftar Chapter</span>
					</a>

					<!-- Next Chapter Button -->
					<% if (typeof nextChapter !== 'undefined' && nextChapter) { %>
						<a href="/komik/chapter/<%= nextChapter %>" class="flex-1 min-w-0 sm:flex-none inline-flex items-center justify-center gap-1 sm:gap-2 px-2.5 sm:px-5 py-2 sm:py-2.5 rounded-full bg-amber-400 hover:bg-[#FACC15] hover:text-black hover:border-black text-black font-black text-xs sm:text-sm uppercase tracking-tight sm:tracking-wider border-2 border-black shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] dark:shadow-[1.5px_1.5px_0px_0px_rgba(255,255,255,0.25)] transition-colors cursor-pointer whitespace-nowrap" title="Chapter Selanjutnya">
							<span class="hidden sm:inline">Selanjutnya</span>
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 flex-shrink-0">
							  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
							</svg>
						</a>
					<% } else { %>
						<span class="flex-1 min-w-0 sm:flex-none inline-flex items-center justify-center gap-1 sm:gap-2 px-2.5 sm:px-5 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-black uppercase tracking-tight sm:tracking-wider text-neutral-400 dark:text-neutral-500 bg-neutral-100 dark:bg-[#121317] border-2 border-neutral-300 dark:border-neutral-700/80 cursor-not-allowed opacity-60 whitespace-nowrap">
							<span class="hidden sm:inline">Selanjutnya</span>
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 flex-shrink-0">
							  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
							</svg>
						</span>
					<% } %>

				</div>

				<!-- Manga Images Container -->
				<section id="comicImagesContainer" class="w-full relative bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-3xl p-3 sm:p-6 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] dark:shadow-[6px_6px_0px_0px_rgba(255,255,255,0.15)]">
					<div class="flex flex-col items-center justify-center gap-1 sm:gap-2 max-w-3xl mx-auto">
						<% if (data && data.length > 0) { %>
							<% data.forEach((item, index) => { %>
								<div class="w-full relative flex justify-center bg-neutral-900 rounded-lg overflow-hidden border border-black/10 dark:border-white/10">
									<img src="<%= item.img %>" alt="<%= item.alt || ('Page ' + (index + 1)) %>" class="w-full max-w-2xl h-auto object-contain" loading="lazy" onerror="this.onerror=null; this.src='/assets/images/no-img.jpg';">
								</div>
							<% }); %>
						<% } else { %>
							<div class="py-16 text-center text-neutral-500 font-bold">
								Tidak ada gambar chapter tersedia.
							</div>
						<% } %>
					</div>
				</section>

				<!-- Bottom Chapter Navigation Bar -->
				<div class="w-full flex items-center justify-between px-2.5 sm:px-5 py-2 sm:py-3 bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-2xl sm:rounded-3xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,0.15)] gap-1.5 sm:gap-3">
					
					<!-- Prev Chapter Button -->
					<% if (typeof prevChapter !== 'undefined' && prevChapter) { %>
						<a href="/komik/chapter/<%= prevChapter %>" class="flex-1 min-w-0 sm:flex-none inline-flex items-center justify-center gap-1 sm:gap-2 px-2.5 sm:px-5 py-2 sm:py-2.5 rounded-full bg-[#F5F3EF] dark:bg-[#181920] hover:bg-[#FACC15] hover:text-black hover:border-black dark:hover:bg-[#FACC15] dark:hover:text-black dark:hover:border-black text-black dark:text-white font-black text-xs sm:text-sm uppercase tracking-tight sm:tracking-wider border-2 border-black dark:border-white shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] dark:shadow-[1.5px_1.5px_0px_0px_rgba(255,255,255,0.25)] transition-colors cursor-pointer whitespace-nowrap" title="Chapter Sebelumnya">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 flex-shrink-0">
							  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
							</svg>
							<span class="hidden sm:inline">Sebelumnya</span>
						</a>
					<% } else { %>
						<span class="flex-1 min-w-0 sm:flex-none inline-flex items-center justify-center gap-1 sm:gap-2 px-2.5 sm:px-5 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-black uppercase tracking-tight sm:tracking-wider text-neutral-400 dark:text-neutral-500 bg-neutral-100 dark:bg-[#121317] border-2 border-neutral-300 dark:border-neutral-700/80 cursor-not-allowed opacity-60 whitespace-nowrap">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 flex-shrink-0">
							  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
							</svg>
							<span class="hidden sm:inline">Sebelumnya</span>
						</span>
					<% } %>

					<!-- Daftar Chapter Center Button -->
					<a href="/komik/detail/<%= typeof comicSlug !== 'undefined' && comicSlug ? comicSlug : '' %>" class="flex-shrink-0 inline-flex items-center justify-center gap-1.5 sm:gap-2 w-9 h-9 sm:w-auto sm:h-auto sm:px-4 sm:py-2.5 rounded-full bg-[#F5F3EF] dark:bg-[#181920] hover:bg-[#FACC15] hover:text-black hover:border-black dark:hover:bg-[#FACC15] dark:hover:text-black dark:hover:border-black text-black dark:text-white border-2 border-black dark:border-white shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] dark:shadow-[1.5px_1.5px_0px_0px_rgba(255,255,255,0.25)] transition-colors cursor-pointer whitespace-nowrap" title="Daftar Chapter">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 flex-shrink-0 text-[#FACC15]">
							<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
						</svg>
						<span class="hidden sm:inline text-xs sm:text-sm font-black uppercase tracking-wider">Daftar Chapter</span>
					</a>

					<!-- Next Chapter Button -->
					<% if (typeof nextChapter !== 'undefined' && nextChapter) { %>
						<a href="/komik/chapter/<%= nextChapter %>" class="flex-1 min-w-0 sm:flex-none inline-flex items-center justify-center gap-1 sm:gap-2 px-2.5 sm:px-5 py-2 sm:py-2.5 rounded-full bg-amber-400 hover:bg-[#FACC15] hover:text-black hover:border-black text-black font-black text-xs sm:text-sm uppercase tracking-tight sm:tracking-wider border-2 border-black shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] dark:shadow-[1.5px_1.5px_0px_0px_rgba(255,255,255,0.25)] transition-colors cursor-pointer whitespace-nowrap" title="Chapter Selanjutnya">
							<span class="hidden sm:inline">Selanjutnya</span>
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 flex-shrink-0">
							  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
							</svg>
						</a>
					<% } else { %>
						<span class="flex-1 min-w-0 sm:flex-none inline-flex items-center justify-center gap-1 sm:gap-2 px-2.5 sm:px-5 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-black uppercase tracking-tight sm:tracking-wider text-neutral-400 dark:text-neutral-500 bg-neutral-100 dark:bg-[#121317] border-2 border-neutral-300 dark:border-neutral-700/80 cursor-not-allowed opacity-60 whitespace-nowrap">
							<span class="hidden sm:inline">Selanjutnya</span>
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 flex-shrink-0">
							  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
							</svg>
						</span>
					<% } %>

				</div>

				<!-- End of Chapter Action Card -->
				<div class="w-full bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-3xl p-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,0.15)] flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
					<div>
						<h3 class="font-black text-sm uppercase text-black dark:text-white">Kamu telah mencapai akhir chapter!</h3>
						<p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">Ingin kembali ke katalog atau mencari komik lainnya?</p>
					</div>
					<div class="flex items-center gap-3">
						<a href="/komik" class="px-4 py-2 rounded-xl bg-amber-400 hover:bg-[#FACC15] text-black font-black text-xs border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-colors">
							Katalog Komik
						</a>
						<button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="px-4 py-2 rounded-xl bg-white dark:bg-neutral-800 hover:bg-[#FACC15] hover:text-black hover:border-black text-black dark:text-white font-bold text-xs border-2 border-black dark:border-white/30 transition-colors cursor-pointer">
							↑ Ke Atas
						</button>
					</div>
				</div>

			</article>

			<!-- SIDEBAR AREA (Right - 4 cols on lg) -->
			<aside class="lg:col-span-4 w-full flex flex-col gap-4 lg:sticky lg:top-24">
				
				<div class="w-full bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-3xl p-5 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,0.15)] flex flex-col gap-4">
					
					<div class="flex items-center justify-between pb-3 border-b-2 border-black dark:border-white/20">
						<div class="flex items-center gap-2">
							<span class="w-3 h-3 bg-amber-400 border border-black inline-block"></span>
							<h3 class="text-base font-black uppercase text-black dark:text-white">
								Komik Populer 🔥
							</h3>
						</div>
					</div>

					<% if (Array.isArray(getDataSidebar) && getDataSidebar.length > 0) { %>
						<div class="flex flex-col gap-3">
							<% getDataSidebar.forEach((item, idx) => { %>
								<a href="/komik/detail/<%= item.slug %>" class="group flex items-center gap-3 p-2.5 rounded-2xl bg-[#F5F3EF] dark:bg-[#121317] border border-black/10 dark:border-white/10 hover:border-black dark:hover:border-white/30 hover:bg-amber-100 dark:hover:bg-neutral-800 ">
									<div class="relative w-12 h-16 rounded-xl overflow-hidden flex-shrink-0 border border-black/20 dark:border-white/20 bg-neutral-200 dark:bg-neutral-800">
										<img src="<%= item.image %>" alt="<%= item.title %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" onerror="this.onerror=null; this.src='/assets/images/no-img.jpg';">
										<span class="absolute top-0.5 left-0.5 w-4 h-4 rounded text-[9px] font-black flex items-center justify-center <%= idx === 0 ? 'bg-amber-400 text-black' : (idx === 1 ? 'bg-slate-300 text-black' : (idx === 2 ? 'bg-amber-700 text-white' : 'bg-black/70 text-white')) %>">
											<%= idx + 1 %>
										</span>
									</div>
									<div class="flex-1 min-w-0">
										<h4 class="text-xs font-bold text-black dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 truncate leading-snug">
											<%= item.title %>
										</h4>
										<div class="flex items-center gap-1.5 mt-1 text-[10px] text-neutral-500 dark:text-neutral-400">
											<span class="px-1.5 py-0.2 rounded bg-black/10 dark:bg-white/10 font-bold uppercase">
												<%= item.type || 'MANGA' %>
											</span>
											<span class="truncate">
												<%= item.genre || item.chapter || 'Updated' %>
											</span>
										</div>
									</div>
								</a>
							<% }) %>
						</div>
					<% } else { %>
						<p class="text-neutral-500 text-xs text-center py-4">Belum ada komik tersedia.</p>
					<% } %>

				</div>

			</aside>

		</div>

	</main>

	<!-- FLOATING ULTRA-SLEEK EXPANDABLE COMIC SCROLLER ("SISTEM MELAR") -->
	<div id="comicScroller" class="fixed z-[9999] select-none opacity-95 hover:opacity-100 transition-opacity duration-200 group/scroller pointer-events-auto" style="top: 50%; left: 16px; transform: translateY(-50%);">
		
		<!-- Main Fixed-Width Unified Vertical Pillar -->
		<div class="relative w-10 flex flex-col items-center p-1 rounded-2xl bg-white/95 dark:bg-[#181920]/95 backdrop-blur-md border-2 border-black dark:border-white/20 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] dark:shadow-[3px_3px_0px_0px_rgba(255,255,255,0.15)] gap-1">
			
			<!-- Go to Top -->
			<button id="btnScrollTop" title="Paling Atas" class="w-8 h-8 rounded-xl flex items-center justify-center bg-[#F5F3EF] dark:bg-[#121317] hover:bg-[#FACC15] hover:text-black text-black dark:text-white transition-colors cursor-pointer">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
				  <path fill-rule="evenodd" d="M10 17a.75.75 0 0 1-.75-.75V5.612L5.29 9.77a.75.75 0 0 1-1.08-1.04l5.25-5.5a.75.75 0 0 1 1.08 0l5.25 5.5a.75.75 0 1 1-1.08 1.04l-3.96-4.158V16.25A.75.75 0 0 1 10 17Z" clip-rule="evenodd" />
				</svg>
			</button>

			<!-- Step Up (Page Up) -->
			<button id="btnScrollPageUp" title="Naik (K)" class="w-8 h-8 rounded-xl flex items-center justify-center bg-[#F5F3EF] dark:bg-[#121317] hover:bg-[#FACC15] hover:text-black text-black dark:text-white transition-colors cursor-pointer">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
				  <path fill-rule="evenodd" d="M14.77 12.79a.75.75 0 0 1-1.06-.02L10 8.832 6.29 12.77a.75.75 0 1 1-1.08-1.04l4.25-4.5a.75.75 0 0 1 1.08 0l4.25 4.5a.75.75 0 0 1-.02 1.06Z" clip-rule="evenodd" />
				</svg>
			</button>

			<!-- Auto-Scroll & Expandable Speed Drawer ("Melar" strictly on Auto button hover) -->
			<div class="relative w-8 flex items-center justify-center group/auto">
				<!-- Speed Drawer (Anchored to the right of Auto button, expands only on Auto hover) -->
				<div id="speedDrawer" class="absolute left-full top-1/2 -translate-y-1/2 flex items-center max-w-0 opacity-0 overflow-hidden transition-all duration-300 ease-out group-hover/auto:max-w-[200px] group-hover/auto:opacity-100 group-hover/auto:pl-2 pointer-events-none group-hover/auto:pointer-events-auto">
					<div class="flex items-center gap-1 p-1 rounded-2xl bg-white/95 dark:bg-[#181920]/95 backdrop-blur-md border-2 border-black dark:border-white/20 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] dark:shadow-[3px_3px_0px_0px_rgba(255,255,255,0.15)] text-[10px] font-mono font-black">
						<button class="speed-btn px-2 py-1 rounded-xl bg-[#FACC15] text-black font-black border border-black cursor-pointer transition-colors text-[10px]" data-speed="1">1x</button>
						<button class="speed-btn px-2 py-1 rounded-xl bg-[#F5F3EF] dark:bg-[#121317] text-black dark:text-white hover:bg-[#FACC15] hover:text-black border border-black/10 dark:border-white/10 cursor-pointer transition-colors text-[10px]" data-speed="2">2x</button>
						<button class="speed-btn px-2 py-1 rounded-xl bg-[#F5F3EF] dark:bg-[#121317] text-black dark:text-white hover:bg-[#FACC15] hover:text-black border border-black/10 dark:border-white/10 cursor-pointer transition-colors text-[10px]" data-speed="3">3x</button>
						<button class="speed-btn px-2 py-1 rounded-xl bg-[#F5F3EF] dark:bg-[#121317] text-black dark:text-white hover:bg-[#FACC15] hover:text-black border border-black/10 dark:border-white/10 cursor-pointer transition-colors text-[10px]" data-speed="5">5x</button>
					</div>
				</div>

				<!-- Auto Toggle Button (Aligned exactly in line with up/down buttons) -->
				<button id="btnAutoScroll" title="Auto Scroll (A) - Klik Play/Pause, Hover untuk pilih Speed" class="w-8 h-9 rounded-xl flex-shrink-0 flex flex-col items-center justify-center bg-[#F5F3EF] dark:bg-[#121317] hover:bg-[#FACC15] hover:text-black text-black dark:text-white border border-black/15 dark:border-white/15 transition-colors font-mono font-black text-[9px] cursor-pointer">
					<svg id="iconPlayAuto" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5 text-emerald-500">
					  <path d="M6.3 2.84A1.5 1.5 0 0 0 4 4.11v11.78a1.5 1.5 0 0 0 2.3 1.27l9.344-5.891a1.5 1.5 0 0 0 0-2.538L6.3 2.841Z" />
					</svg>
					<svg id="iconPauseAuto" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5 hidden text-rose-500">
					  <path d="M5.75 3a.75.75 0 0 0-.75.75v12.5c0 .414.336.75.75.75h1.5a.75.75 0 0 0 .75-.75V3.75A.75.75 0 0 0 7.25 3h-1.5ZM12.75 3a.75.75 0 0 0-.75.75v12.5c0 .414.336.75.75.75h1.5a.75.75 0 0 0 .75-.75V3.75a.75.75 0 0 0-.75-.75h-1.5Z" />
					</svg>
					<span id="autoSpeedText" class="text-[7px] uppercase tracking-tighter leading-none mt-0.5">Auto</span>
				</button>
			</div>

			<!-- Step Down (Page Down) -->
			<button id="btnScrollPageDown" title="Turun (J / Space)" class="w-8 h-8 rounded-xl flex items-center justify-center bg-[#F5F3EF] dark:bg-[#121317] hover:bg-[#FACC15] hover:text-black text-black dark:text-white transition-colors cursor-pointer">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
				  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1-.02-1.06Z" clip-rule="evenodd" />
				</svg>
			</button>

			<!-- Go to Bottom -->
			<button id="btnScrollBottom" title="Paling Bawah" class="w-8 h-8 rounded-xl flex items-center justify-center bg-[#F5F3EF] dark:bg-[#121317] hover:bg-[#FACC15] hover:text-black text-black dark:text-white transition-colors cursor-pointer">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
				  <path fill-rule="evenodd" d="M10 3a.75.75 0 0 1 .75.75v10.638l3.96-4.158a.75.75 0 1 1 1.08 1.04l-5.25 5.5a.75.75 0 0 1-1.08 0l-5.25-5.5a.75.75 0 1 1 1.08-1.04l3.96 4.158V3.75A.75.75 0 0 1 10 3Z" clip-rule="evenodd" />
				</svg>
			</button>

			<!-- Mini Progress % inside pillar -->
			<div id="readProgress" class="w-full py-0.5 mt-0.5 text-center text-[#FACC15] bg-black dark:bg-neutral-900 rounded-lg text-[8px] font-mono font-black">
				0%
			</div>

		</div>

	</div>

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const btnTop = document.getElementById('btnScrollTop');
			const btnBottom = document.getElementById('btnScrollBottom');
			const btnPageUp = document.getElementById('btnScrollPageUp');
			const btnPageDown = document.getElementById('btnScrollPageDown');
			const btnAuto = document.getElementById('btnAutoScroll');
			const iconPlay = document.getElementById('iconPlayAuto');
			const iconPause = document.getElementById('iconPauseAuto');
			const autoSpeedText = document.getElementById('autoSpeedText');
			const speedDrawer = document.getElementById('speedDrawer');
			const speedBtns = document.querySelectorAll('.speed-btn');
			const progressBadge = document.getElementById('readProgress');
			const comicScroller = document.getElementById('comicScroller');
			const comicContainer = document.getElementById('comicImagesContainer');

			let currentSpeed = 1;
			const speedMap = {
				1: 1.5,
				2: 3.0,
				3: 5.5,
				5: 9.0
			};

			const getStep = () => window.innerHeight * 0.75;

			function alignScroller() {
				if (!comicScroller) return;

				const comicFrame = document.querySelector('#comicImagesContainer, article, .comic-frame');
				const frameRect = comicFrame ? comicFrame.getBoundingClientRect() : null;
				const panelWidth = comicScroller.offsetWidth || 72;
				comicScroller.style.top = '50%';
				comicScroller.style.transform = 'translateY(-50%)';
				comicScroller.style.right = 'auto';
				comicScroller.style.left = frameRect ? (Math.max(16, frameRect.left - panelWidth - 18)) + 'px' : '16px';

				// Update reading progress % based on comic container
				if (comicContainer) {
					const rect = comicContainer.getBoundingClientRect();
					const totalHeight = comicContainer.offsetHeight - window.innerHeight;
					if (totalHeight > 0) {
						const scrolled = -rect.top;
						const percent = Math.min(100, Math.max(0, Math.round((scrolled / totalHeight) * 100)));
						if (progressBadge) progressBadge.textContent = percent + '%';
					}
				}
			}

			btnTop?.addEventListener('click', () => {
				stopAutoScroll();
				const targetY = comicContainer ? (comicContainer.getBoundingClientRect().top + window.scrollY - 80) : 0;
				window.scrollTo({ top: Math.max(0, targetY), behavior: 'smooth' });
			});

			btnBottom?.addEventListener('click', () => {
				stopAutoScroll();
				const targetY = comicContainer ? (comicContainer.getBoundingClientRect().bottom + window.scrollY - window.innerHeight) : document.documentElement.scrollHeight;
				window.scrollTo({ top: targetY, behavior: 'smooth' });
			});

			btnPageUp?.addEventListener('click', () => {
				stopAutoScroll();
				window.scrollBy({ top: -getStep(), behavior: 'smooth' });
			});

			btnPageDown?.addEventListener('click', () => {
				stopAutoScroll();
				window.scrollBy({ top: getStep(), behavior: 'smooth' });
			});

			let autoScrollInterval = null;
			let isAutoScrolling = false;

			function startAutoScroll() {
				isAutoScrolling = true;
				iconPlay?.classList.add('hidden');
				iconPause?.classList.remove('hidden');
				btnAuto?.classList.add('bg-[#FACC15]', 'text-black');
				if (autoSpeedText) autoSpeedText.textContent = `${currentSpeed}x`;
				
				const pixelsPerTick = speedMap[currentSpeed] || 1.5;

				if (autoScrollInterval) clearInterval(autoScrollInterval);
				autoScrollInterval = setInterval(() => {
					window.scrollBy({ top: pixelsPerTick, behavior: 'auto' });
					if ((window.innerHeight + window.scrollY) >= document.documentElement.scrollHeight - 10) {
						stopAutoScroll();
					}
				}, 16);
			}

			function stopAutoScroll() {
				if (isAutoScrolling) {
					isAutoScrolling = false;
					clearInterval(autoScrollInterval);
					autoScrollInterval = null;
					iconPlay?.classList.remove('hidden');
					iconPause?.classList.add('hidden');
					btnAuto?.classList.remove('bg-[#FACC15]', 'text-black');
					if (autoSpeedText) autoSpeedText.textContent = 'Auto';
				}
			}

			btnAuto?.addEventListener('click', () => {
				if (isAutoScrolling) {
					stopAutoScroll();
				} else {
					startAutoScroll();
				}
			});

			// Speed selection buttons
			speedBtns.forEach(btn => {
				btn.addEventListener('click', (e) => {
					e.stopPropagation();
					const speedVal = Number(btn.getAttribute('data-speed'));
					currentSpeed = speedVal;

					speedBtns.forEach(b => {
						b.className = 'speed-btn px-2 py-1 rounded-xl bg-[#F5F3EF] dark:bg-[#121317] text-black dark:text-white hover:bg-[#FACC15] hover:text-black border border-black/10 dark:border-white/10 cursor-pointer transition-colors text-[10px]';
					});
					btn.className = 'speed-btn px-2 py-1 rounded-xl bg-[#FACC15] text-black font-black border border-black cursor-pointer transition-colors text-[10px]';

					if (isAutoScrolling) {
						startAutoScroll();
					} else {
						if (autoSpeedText) autoSpeedText.textContent = `${currentSpeed}x`;
					}
				});
			});

			window.addEventListener('wheel', () => stopAutoScroll(), { passive: true });
			window.addEventListener('touchmove', () => stopAutoScroll(), { passive: true });

			window.addEventListener('keydown', (e) => {
				if (['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) return;
				if (e.key === 'j' || e.key === 'J') {
					stopAutoScroll();
					window.scrollBy({ top: getStep(), behavior: 'smooth' });
				} else if (e.key === 'k' || e.key === 'K') {
					stopAutoScroll();
					window.scrollBy({ top: -getStep(), behavior: 'smooth' });
				} else if (e.key === 'a' || e.key === 'A') {
					btnAuto?.click();
				} else if (['1', '2', '3', '4'].includes(e.key)) {
					const speeds = [1, 2, 3, 5];
					const idx = Number(e.key) - 1;
					const targetBtn = document.querySelector(`.speed-btn[data-speed="${speeds[idx]}"]`);
					targetBtn?.click();
				} else if (e.key === 'ArrowLeft' || e.key === 'h' || e.key === 'H') {
					<% if (typeof prevChapter !== 'undefined' && prevChapter) { %>
						window.location.href = '/komik/chapter/<%= prevChapter %>';
					<% } %>
				} else if (e.key === 'ArrowRight' || e.key === 'l' || e.key === 'L') {
					<% if (typeof nextChapter !== 'undefined' && nextChapter) { %>
						window.location.href = '/komik/chapter/<%= nextChapter %>';
					<% } %>
				}
			});

			window.addEventListener('scroll', alignScroller, { passive: true });
			window.addEventListener('resize', alignScroller, { passive: true });
			window.addEventListener('load', alignScroller);
			alignScroller();
			setTimeout(alignScroller, 100);
			setTimeout(alignScroller, 300);
			setTimeout(alignScroller, 800);
			setTimeout(alignScroller, 1500);
		});
	</script>

	<%- include('partials/footer-komik'); %>
	<%- include('partials/script'); %>
</body>
</html>
