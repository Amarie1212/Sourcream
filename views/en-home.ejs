<!DOCTYPE html>
<html lang="en">
<head>
	<title><%= site_title %></title>
	<meta name="description" content="<%= site_desc %>">
	<meta name="keywords" content="<%= site_keyword %>">
	<meta property="og:title" content="<%= site_title %>">
	<meta property="og:description" content="<%= site_desc %>">
	<meta property="og:url" content="https://<%= site_url %>/en">
	<meta property="og:image" content="https://<%= site_url %>/assets/images/og.png">
	<%- include('partials/head'); %>
	<style>
		.neo-card {
			transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		}
		.neo-card:hover {
			transform: translateY(-4px);
			box-shadow: 6px 6px 0px 0px rgba(0, 0, 0, 1);
		}
		.dark .neo-card:hover {
			box-shadow: 6px 6px 0px 0px rgba(226, 248, 76, 0.3);
		}
	</style>
</head>
<body class="bg-[#EAE7DE] dark:bg-[#111216] text-black dark:text-white min-h-screen flex flex-col font-sans">
	<%- include('partials/header'); %>
		
	<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 md:py-8 flex flex-col gap-8">

		<!-- HERO BANNER FOR ENGLISH ANIME -->
		<section class="w-full bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-3xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] dark:shadow-[6px_6px_0px_0px_rgba(255,255,255,0.15)] flex flex-col md:flex-row items-center justify-between gap-6 relative overflow-hidden">
			<div class="flex-1 flex flex-col gap-3 z-10 text-center md:text-left items-center md:items-start">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400 text-black border-2 border-black text-xs font-black uppercase shadow-xs">
					<span>🇬🇧 English Anime Hub</span>
					<span>•</span>
					<span>Sub & Dub</span>
				</div>
				<h1 class="text-2xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight text-black dark:text-white leading-tight">
					Watch Anime in <span class="bg-[#FACC15] text-black px-2 py-0.5 rounded-lg border-2 border-black inline-block shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">English</span>
				</h1>
				<p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 max-w-xl font-bold">
					Explore thousands of anime episodes with English Subtitles and English Dubbing powered by Gogoanime.
				</p>

				<!-- English Search Bar -->
				<form action="/en/search" method="GET" class="w-full max-w-md mt-2 flex items-center gap-2">
				<!-- Search Bar -->
				<form action="/search" method="GET" class="w-full max-w-md mt-2 flex items-center gap-2">
					<div class="relative flex-1">
						<input type="text" name="q" placeholder="Search anime in English (e.g. One Piece, Naruto)..." class="w-full px-4 py-2.5 pl-10 rounded-2xl bg-[#F5F3EF] dark:bg-[#111216] border-2 border-black dark:border-white/30 text-xs sm:text-sm font-bold text-black dark:text-white focus:outline-none focus:ring-2 focus:ring-amber-400">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-neutral-400 absolute left-3.5 top-1/2 -translate-y-1/2">
							<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
						</svg>
					</div>
					<button type="submit" class="px-5 py-2.5 rounded-2xl bg-violet-600 text-white font-black text-xs sm:text-sm uppercase tracking-wider border-2 border-black dark:border-white shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-black transition-all cursor-pointer flex-shrink-0">
						Search
					</button>
				</form>
			</div>

			<div class="flex-shrink-0 flex items-center gap-3">
				<a href="/" class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl bg-[#F5F3EF] dark:bg-[#111216] border-2 border-black dark:border-white/20 text-xs font-black uppercase hover:bg-amber-400 hover:text-black transition-all">
					<span>🇮🇩 Kembali ke Sub Indo</span>
				<a href="/id" class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl bg-[#F5F3EF] dark:bg-[#111216] border-2 border-black dark:border-white/20 text-xs font-black uppercase hover:bg-amber-400 hover:text-black transition-all">
					<span>🇮🇩 Versi Sub Indo</span>
					<span>→</span>
				</a>
			</div>
		</section>

		<!-- SECTION: LATEST EPISODES -->
		<section class="w-full flex flex-col gap-5">
			<div class="flex items-center justify-between pb-2 border-b-2 border-black dark:border-white/20 gap-2">
				<div class="flex items-center gap-2 min-w-0">
					<span class="w-3.5 h-3.5 bg-amber-400 border border-black inline-block flex-shrink-0"></span>
					<h2 class="text-base sm:text-2xl md:text-3xl font-black uppercase tracking-tight text-black dark:text-white truncate">
						Latest English Episodes 🔥
					</h2>
					<span class="px-2.5 py-0.5 rounded-full text-xs font-black uppercase bg-black text-[#FACC15] border border-black">
						Page <%= page %>
					</span>
				</div>
			</div>

			<!-- Grid Anime Cards -->
			<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 sm:gap-5">
				<% if (data && data.length > 0) { %>
					<% data.forEach((item) => { %>
						<a href="/en/episode/<%= item.slug %>" class="neo-card group flex flex-col bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] dark:shadow-[3px_3px_0px_0px_rgba(255,255,255,0.15)] relative">
						<a href="/episode/<%= item.slug %>" class="neo-card group flex flex-col bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] dark:shadow-[3px_3px_0px_0px_rgba(255,255,255,0.15)] relative">
							
							<!-- Thumbnail Wrapper -->
							<div class="relative aspect-[3/4] w-full overflow-hidden bg-neutral-200 dark:bg-neutral-800">
								<img class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300" src="<%= item.image %>" alt="<%= item.title %>" onerror="this.onerror=null; this.src='/assets/images/no-img.jpg';">
								
								<!-- Episode Pill Badge -->
								<% if (item.episodes) { %>
									<div class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-[#FACC15] text-black border border-black text-[10px] font-black uppercase shadow-xs">
										<%= item.episodes %>
									</div>
								<% } %>

								<!-- Type Tag (SUB vs DUB) -->
								<% if (item.type) { %>
									<div class="absolute top-2 right-2 px-1.5 py-0.5 rounded text-[9px] font-bold uppercase backdrop-blur-xs border border-black/30 <%= item.type === 'DUB' ? 'bg-rose-500 text-white' : 'bg-black/80 text-white' %>">
										<%= item.type %>
									</div>
								<% } %>

								<!-- Hover play overlay -->
								<div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-center">
									<div class="w-10 h-10 rounded-full bg-[#FACC15] text-black border-2 border-black flex items-center justify-center shadow-md transform scale-75 group-hover:scale-100 transition-transform">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 ml-0.5">
										  <path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd" />
										</svg>
									</div>
								</div>
							</div>

							<!-- Card Content Bottom -->
							<div class="p-3 flex flex-col gap-1.5 flex-1 justify-between bg-white dark:bg-[#181920]">
								<h3 class="font-extrabold text-xs sm:text-sm text-black dark:text-white line-clamp-2 leading-tight group-hover:text-amber-500 transition-colors" title="<%= item.title %>">
									<%= item.title %>
								</h3>
								<div class="flex items-center justify-between text-[11px] text-neutral-500 dark:text-neutral-400 font-bold mt-1">
									<span class="truncate"><%= item.status %></span>
									<span class="text-amber-500 text-xs font-black">▶ Watch</span>
								</div>
							</div>
						</a>
					<% }); %>
				<% } else { %>
					<div class="col-span-full py-12 text-center text-neutral-500 font-bold">
						No anime episodes found.
					</div>
				<% } %>
			</div>

			<!-- Pagination Controls -->
			<div class="flex items-center justify-center gap-3 pt-6">
				<% if (page > 1) { %>
					<a href="/en?page=<%= page - 1 %>" class="px-5 py-2.5 rounded-2xl bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 text-xs font-black uppercase hover:bg-amber-400 hover:text-black transition-all shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
					<a href="/?page=<%= page - 1 %>" class="px-5 py-2.5 rounded-2xl bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 text-xs font-black uppercase hover:bg-amber-400 hover:text-black transition-all shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
						← Prev Page
					</a>
				<% } %>
				<span class="px-4 py-2 rounded-2xl bg-[#F5F3EF] dark:bg-[#111216] border border-black/10 dark:border-white/10 text-xs font-black">
					Page <%= page %>
				</span>
				<a href="/en?page=<%= page + 1 %>" class="px-5 py-2.5 rounded-2xl bg-amber-400 text-black border-2 border-black text-xs font-black uppercase hover:bg-black hover:text-white transition-all shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
				<a href="/?page=<%= page + 1 %>" class="px-5 py-2.5 rounded-2xl bg-amber-400 text-black border-2 border-black text-xs font-black uppercase hover:bg-black hover:text-white transition-all shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
					Next Page →
				</a>
			</div>

		</section>

	</main>

	<%- include('partials/footer'); %>
</body>
</html>
