<!DOCTYPE html>
<html lang="en">
<head>
	<title><%= site_title %></title>
	<meta name="description" content="<%= site_desc %>">
	<meta name="keywords" content="<%= site_keyword %>">
	<meta property="og:title" content="<%= site_title %>">
	<meta property="og:description" content="<%= site_desc %>">
	<meta property="og:url" content="https://<%= site_url %>/en/search">
	<%- include('partials/head'); %>
	<style>
		.neo-card {
			transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		}
		.neo-card:hover {
			transform: translateY(-4px);
			box-shadow: 6px 6px 0px 0px rgba(0, 0, 0, 1);
		}
		.dark .neo-card:hover {
			box-shadow: 6px 6px 0px 0px rgba(226, 248, 76, 0.3);
		}
	</style>
</head>
<body class="bg-[#EAE7DE] dark:bg-[#111216] text-black dark:text-white min-h-screen flex flex-col font-sans">
	<%- include('partials/header'); %>
		
	<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 md:py-8 flex flex-col gap-6">

		<!-- SEARCH HEADER -->
		<section class="w-full bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-3xl p-6 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] dark:shadow-[6px_6px_0px_0px_rgba(255,255,255,0.15)] flex flex-col gap-4">
			<div class="flex items-center gap-2">
				<span class="w-3.5 h-3.5 bg-amber-400 border border-black inline-block flex-shrink-0"></span>
				<h1 class="text-xl sm:text-3xl font-black uppercase tracking-tight text-black dark:text-white">
					Search English Anime (Sub & Dub)
				</h1>
			</div>

			<form action="/en/search" method="GET" class="w-full flex items-center gap-3">
			<form action="/search" method="GET" class="w-full flex items-center gap-3">
				<div class="relative flex-1">
					<input type="text" name="q" value="<%= query %>" placeholder="Type anime title..." class="w-full px-4 py-2.5 pl-10 rounded-2xl bg-[#F5F3EF] dark:bg-[#111216] border-2 border-black dark:border-white/30 text-xs sm:text-sm font-bold text-black dark:text-white focus:outline-none focus:ring-2 focus:ring-amber-400">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-neutral-400 absolute left-3.5 top-1/2 -translate-y-1/2">
						<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
					</svg>
				</div>
				<button type="submit" class="px-5 py-2.5 rounded-2xl bg-amber-400 text-black font-black text-xs sm:text-sm uppercase tracking-wider border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-black hover:text-white transition-all cursor-pointer">
					Search
				</button>
			</form>
		</section>

		<!-- RESULTS -->
		<section class="w-full flex flex-col gap-4">
			<div class="flex items-center justify-between pb-2 border-b-2 border-black dark:border-white/20">
				<h2 class="text-base sm:text-xl font-black uppercase tracking-tight text-black dark:text-white">
					Results for: <span class="text-amber-500">"<%= query %>"</span>
				</h2>
				<span class="px-2.5 py-0.5 rounded-full text-xs font-black uppercase bg-black text-[#FACC15] border border-black">
					<%= data.length %> Titles
				</span>
			</div>

			<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 sm:gap-5">
				<% if (data && data.length > 0) { %>
					<% data.forEach((item) => { %>
						<a href="/en/anime/<%= item.slug %>" class="neo-card group flex flex-col bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] dark:shadow-[3px_3px_0px_0px_rgba(255,255,255,0.15)] relative">
						<a href="/anime/<%= item.slug %>" class="neo-card group flex flex-col bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] dark:shadow-[3px_3px_0px_0px_rgba(255,255,255,0.15)] relative">
							
							<div class="relative aspect-[3/4] w-full overflow-hidden bg-neutral-200 dark:bg-neutral-800">
								<img class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300" src="<%= item.image %>" alt="<%= item.title %>" onerror="this.onerror=null; this.src='/assets/images/no-img.jpg';">
								
								<% if (item.type) { %>
									<div class="absolute top-2 right-2 px-1.5 py-0.5 rounded text-[9px] font-bold uppercase backdrop-blur-xs border border-black/30 <%= item.type === 'DUB' ? 'bg-rose-500 text-white' : 'bg-black/80 text-white' %>">
										<%= item.type %>
									</div>
								<% } %>
							</div>

							<div class="p-3 flex flex-col gap-1.5 flex-1 justify-between bg-white dark:bg-[#181920]">
								<h3 class="font-extrabold text-xs sm:text-sm text-black dark:text-white line-clamp-2 leading-tight group-hover:text-amber-500 transition-colors" title="<%= item.title %>">
									<%= item.title %>
								</h3>
								<div class="flex items-center justify-between text-[11px] text-neutral-500 dark:text-neutral-400 font-bold mt-1">
									<span class="truncate"><%= item.episodes %></span>
									<span class="text-amber-500 text-xs font-black">View →</span>
								</div>
							</div>
						</a>
					<% }); %>
				<% } else { %>
					<div class="col-span-full py-16 text-center text-neutral-500 font-bold">
						No anime found matching your query.
					</div>
				<% } %>
			</div>
		</section>

	</main>

	<%- include('partials/footer'); %>
</body>
</html>
