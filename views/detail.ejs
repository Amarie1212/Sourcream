<!DOCTYPE html>
<html lang="id">
<head>
    <title><%= site_title %></title>
    <meta name="description" content="<%= site_desc %>">
    <meta name="keywords" content="<%= site_keyword %>">
    <meta property="og:title" content="<%= site_title %>">
    <meta property="og:description" content="<%= site_desc %>">
    <meta property="og:url" content="https://<%= site_url %>">
    <meta property="og:image" content="https://<%= site_url %>/assets/images/og.png">
    <%- include('partials/head'); %>
	<style>
		.neo-card {
			transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		}
		.neo-card:hover {
			transform: translateY(-3px);
			box-shadow: 4px 4px 0px 0px rgba(0, 0, 0, 1);
		}
		.dark .neo-card:hover {
			box-shadow: 4px 4px 0px 0px rgba(250, 204, 21, 0.3);
		}
	</style>
</head>
<body class="bg-[#EAE7DE] dark:bg-[#111216] text-black dark:text-white min-h-screen flex flex-col font-sans">
    <%- include('partials/header'); %>

	<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-4 md:py-6 flex flex-col gap-6">
		
		<!-- BREADCRUMB & BACK DIRECTORY BAR (File Explorer Style) -->
		<div class="w-full flex flex-wrap items-center justify-between gap-3 bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 px-4 py-2.5 rounded-2xl shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] dark:shadow-[3px_3px_0px_0px_rgba(255,255,255,0.15)] text-xs font-bold">
			
			<!-- Left: Back Button & Path -->
			<div class="flex items-center gap-2.5 flex-wrap min-w-0">
				
				<!-- Back Button -->
				<button onclick="goBack('/')" 
						class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-[#F5F3EF] dark:bg-[#181920] hover:bg-[#FACC15] hover:text-black hover:border-black dark:hover:bg-[#FACC15] dark:hover:text-black dark:hover:border-black text-black dark:text-white border-2 border-black dark:border-white shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] dark:shadow-[1.5px_1.5px_0px_0px_rgba(255,255,255,0.25)] transition-colors font-black uppercase text-[11px] sm:text-xs tracking-wider cursor-pointer">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5">
					  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
					</svg>
					<span>Kembali</span>
				</button>

				<span class="text-neutral-300 dark:text-neutral-700 hidden sm:inline select-none">|</span>

				<!-- Explorer Path -->
				<nav aria-label="Directory Path" class="flex items-center gap-1.5 text-neutral-600 dark:text-neutral-400 font-mono text-[11px] sm:text-xs overflow-x-auto py-0.5 max-w-full">
					<a href="/" class="flex items-center gap-1.5 hover:text-black dark:hover:text-white transition-colors flex-shrink-0 font-bold">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5 text-amber-500">
						  <path d="M2 4.75C2 3.784 2.784 3 3.75 3h4.836c.464 0 .909.184 1.237.513l1.414 1.414a.25.25 0 0 0 .177.073h4.836c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0 1 16.25 17H3.75A1.75 1.75 0 0 1 2 15.25V4.75Z" />
						</svg>
						<span>main</span>
					</a>
					
					<span class="text-neutral-400 select-none">/</span>

					<a href="/terbaru" class="hover:text-black dark:hover:text-white transition-colors flex-shrink-0 font-bold">
						anime
					</a>

					<span class="text-neutral-400 select-none">/</span>

					<span class="text-black dark:text-[#FACC15] font-black truncate max-w-[180px] sm:max-w-[320px] flex-shrink-0 bg-black/5 dark:bg-white/5 px-2 py-0.5 rounded border border-black/10 dark:border-white/10">
						<%= data.title %>
					</span>
				</nav>

			</div>

		</div>

		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
			
			<!-- MAIN CONTENT AREA (Left) -->
			<div class="lg:col-span-8 flex flex-col gap-8">
				
				<!-- ANIME HERO DETAIL CARD -->
				<section class="w-full bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-3xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] dark:shadow-[6px_6px_0px_0px_rgba(255,255,255,0.15)] relative overflow-hidden">
					
					<div class="flex flex-col sm:flex-row gap-6 md:gap-8 items-center sm:items-start">
						
						<!-- Cover Poster Image -->
						<div class="w-48 sm:w-56 md:w-64 flex-shrink-0 relative group">
							<div class="w-full aspect-[3/4] rounded-2xl overflow-hidden border-2 border-black dark:border-white/30 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,0.2)] bg-neutral-200 dark:bg-neutral-800">
								<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="<%= data.imageUrl %>" alt="<%= data.title %>" onerror="this.onerror=null; this.src='/assets/images/no-img.jpg';">
							</div>
							
							<!-- Status Pill Badge -->
							<% if (data.status) { %>
								<div class="mt-3 text-center">
									<span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-black uppercase <%= data.status.toLowerCase().includes('selesai') || data.status.toLowerCase().includes('completed') ? 'bg-slate-200 text-slate-800 border border-slate-400' : 'bg-[#FACC15] text-black border border-black shadow-xs' %>">
										<span class="w-1.5 h-1.5 rounded-full bg-current"></span>
										<%= data.status %>
									</span>
								</div>
							<% } %>
						</div>

						<!-- Details & Metadata -->
						<div class="flex-1 flex flex-col gap-4">
							
							<!-- Title -->
							<div>
								<div class="flex flex-wrap items-center gap-2 mb-2">
									<span class="px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase bg-black text-[#FACC15] border border-black">
										<%= data.type || 'ANIME' %>
									</span>
									<% if (data.episodes) { %>
										<span class="px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase bg-violet-600 text-white">
											<%= data.episodes %> Episode
										</span>
									<% } %>
									<span class="px-2.5 py-0.5 rounded-md text-[10px] font-bold bg-neutral-200 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200">
										HD Sub Indo
									</span>
								</div>

								<h1 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-black dark:text-white leading-tight">
									<%= data.title %>
								</h1>
							</div>

							<!-- Action Button: Start Watching -->
							<% if (episodes.length > 0) { %>
								<div class="flex flex-wrap items-center gap-3 pt-1">
									<a href="/episode/<%= episodes[0].slug %>" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-violet-600 hover:bg-black dark:hover:bg-black text-white hover:text-white hover:border-black dark:hover:border-white border-2 border-black dark:border-white shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] dark:shadow-[1.5px_1.5px_0px_0px_rgba(255,255,255,0.25)] transition-colors font-black text-xs sm:text-sm uppercase tracking-wider cursor-pointer">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
										  <path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd" />
										</svg>
										<span>Tonton Episode 1</span>
									</a>
									<a href="/episode/<%= episodes[episodes.length - 1].slug %>" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full bg-white dark:bg-[#181920] hover:bg-[#FACC15] hover:text-black hover:border-black dark:hover:bg-[#FACC15] dark:hover:text-black dark:hover:border-black text-black dark:text-white font-black text-xs sm:text-sm uppercase tracking-wider border-2 border-black dark:border-white shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] dark:shadow-[1.5px_1.5px_0px_0px_rgba(255,255,255,0.25)] transition-colors cursor-pointer">
										<span>Episode Terakhir</span>
										<span>→</span>
									</a>
								</div>
							<% } %>

							<!-- Description -->
							<div class="text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed bg-[#F5F3EF] dark:bg-[#121317] p-4 rounded-2xl border-2 border-black/10 dark:border-white/10">
								<%= data.description.replace(/Animasu/gi, 'Sourcream') %>
							</div>

							<!-- Metadata Info Grid -->
							<div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 text-xs">
								<div class="bg-[#F5F3EF] dark:bg-[#121317] p-2.5 rounded-xl border border-black/10 dark:border-white/10">
									<span class="text-neutral-500 dark:text-neutral-400 block text-[10px] uppercase font-extrabold">Rilis</span>
									<span class="font-bold text-black dark:text-white truncate block"><%= data.releaseDate || '-' %></span>
								</div>
								<div class="bg-[#F5F3EF] dark:bg-[#121317] p-2.5 rounded-xl border border-black/10 dark:border-white/10">
									<span class="text-neutral-500 dark:text-neutral-400 block text-[10px] uppercase font-extrabold">Studio</span>
									<span class="font-bold text-black dark:text-white truncate block"><%= data.studio || '-' %></span>
								</div>
								<div class="bg-[#F5F3EF] dark:bg-[#121317] p-2.5 rounded-xl border border-black/10 dark:border-white/10">
									<span class="text-neutral-500 dark:text-neutral-400 block text-[10px] uppercase font-extrabold">Durasi</span>
									<span class="font-bold text-black dark:text-white truncate block"><%= data.duration || '-' %></span>
								</div>
								<div class="bg-[#F5F3EF] dark:bg-[#121317] p-2.5 rounded-xl border border-black/10 dark:border-white/10">
									<span class="text-neutral-500 dark:text-neutral-400 block text-[10px] uppercase font-extrabold">Season</span>
									<span class="font-bold text-black dark:text-white truncate block"><%= data.season || '-' %></span>
								</div>
								<div class="bg-[#F5F3EF] dark:bg-[#121317] p-2.5 rounded-xl border border-black/10 dark:border-white/10">
									<span class="text-neutral-500 dark:text-neutral-400 block text-[10px] uppercase font-extrabold">Penulis</span>
									<span class="font-bold text-black dark:text-white truncate block"><%= data.author || '-' %></span>
								</div>
								<div class="bg-[#F5F3EF] dark:bg-[#121317] p-2.5 rounded-xl border border-black/10 dark:border-white/10">
									<span class="text-neutral-500 dark:text-neutral-400 block text-[10px] uppercase font-extrabold">Update Terakhir</span>
									<span class="font-bold text-black dark:text-white truncate block"><%= data.updatedAt || '-' %></span>
								</div>
							</div>

							<!-- Genres List -->
							<% if (data.genres) { %>
								<div class="flex flex-wrap items-center gap-1.5 pt-1">
									<span class="text-xs font-black uppercase text-neutral-500 dark:text-neutral-400 mr-1">Genre:</span>
									<% 
										const genreList = Array.isArray(data.genres) ? data.genres : data.genres.split(',').map(g => g.trim());
										genreList.forEach(genre => { 
											if (genre) {
									%>
										<span class="px-2.5 py-1 rounded-lg bg-[#FACC15] text-black border border-black font-black text-[11px] shadow-xs">
											<%= genre %>
										</span>
									<% } }); %>
								</div>
							<% } %>

						</div>
					</div>

				</section>

				<!-- EPISODES LIST SECTION -->
				<section class="w-full flex flex-col gap-4">
					
					<!-- Header Section with Total & Search & Sort Controls -->
					<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b-2 border-black dark:border-white/20">
						<div class="flex items-center gap-2">
							<span class="w-3.5 h-3.5 bg-rose-500 border border-black inline-block"></span>
							<h2 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-black dark:text-white">
								Semua Episode 🔥
							</h2>
							<span class="px-2.5 py-0.5 rounded-full text-xs font-black uppercase bg-black text-[#FACC15] border border-black">
								<%= episodes.length %> Total
							</span>
						</div>

						<div class="flex flex-wrap items-center gap-2">
							<!-- Search Input -->
							<div class="relative">
								<input type="text" id="epDetailSearch" placeholder="Cari episode..." class="w-32 sm:w-44 text-xs px-3 py-1.5 pl-8 rounded-xl bg-[#F5F3EF] dark:bg-[#181920] border border-black/20 dark:border-white/20 text-black dark:text-white focus:outline-none focus:ring-2 focus:ring-violet-500">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 text-neutral-400 absolute left-2.5 top-1/2 -translate-y-1/2">
								  <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
								</svg>
							</div>

							<!-- Sort Toggle Button -->
							<button id="btnDetailSort" type="button" class="px-2.5 py-1.5 rounded-xl bg-[#F5F3EF] dark:bg-[#181920] border border-black/20 dark:border-white/20 text-xs font-black text-black dark:text-white hover:bg-[#FACC15] hover:text-black transition-all flex items-center gap-1" title="Urutkan Episode">
								<span id="sortDetailLabel">1 → <%= episodes.length %></span>
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
								  <path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5 7.5 3m0 0L12 7.5M7.5 3v13.5m13.5 0L16.5 21m0 0L12 16.5m4.5 4.5V7.5" />
								</svg>
							</button>
						</div>
					</div>

					<!-- Range / Chunk Pagination Tabs for Large Episode Count (Skat-skat) -->
					<% 
						const CHUNK_SIZE = 50;
						const totalChunks = Math.ceil(episodes.length / CHUNK_SIZE);
					%>

					<% if (episodes.length > CHUNK_SIZE) { %>
						<div id="rangeTabsContainer" class="flex items-center gap-2 overflow-x-auto pb-2.5 pt-0.5 custom-scrollbar">
							<span class="text-xs font-black uppercase text-neutral-500 dark:text-neutral-400 flex-shrink-0 mr-1">
								Pilih Range:
							</span>
							<% for (let c = 0; c < totalChunks; c++) { 
								const startEp = c * CHUNK_SIZE + 1;
								const endEp = Math.min((c + 1) * CHUNK_SIZE, episodes.length);
							%>
								<button type="button" 
										data-start="<%= startEp %>" 
										data-end="<%= endEp %>"
										class="chunk-tab flex-shrink-0 px-3 py-1.5 rounded-xl border-2 text-xs font-black transition-all <%= c === 0 ? 'bg-violet-600 text-white border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]' : 'bg-white dark:bg-[#181920] text-black dark:text-white border-black/20 dark:border-white/20 hover:border-black hover:bg-[#FACC15] hover:text-black' %>">
									<%= startEp %> - <%= endEp %>
								</button>
							<% } %>
							<button type="button" 
									data-start="all" 
									data-end="all"
									class="chunk-tab flex-shrink-0 px-3 py-1.5 rounded-xl border-2 text-xs font-black transition-all bg-white dark:bg-[#181920] text-black dark:text-white border-black/20 dark:border-white/20 hover:border-black hover:bg-[#FACC15] hover:text-black">
								Semua
							</button>
						</div>
					<% } %>

					<% if (episodes.length > 0) { %>
						<div id="detailEpisodesContainer" class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-[600px] overflow-y-auto pr-1.5 custom-scrollbar">
							<% episodes.forEach((episode, idx) => { 
								const epNumMatch = episode.title.match(/\d+(\.\d+)?/);
								const epNum = epNumMatch ? parseFloat(epNumMatch[0]) : (idx + 1);
							%>
								<a href="/episode/<%= episode.slug %>" 
								   data-ep="<%= epNum %>"
								   data-title="<%= episode.title.toLowerCase() %>"
								   class="ep-card neo-card group flex items-center justify-between p-3.5 bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-2xl shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] dark:shadow-[3px_3px_0px_0px_rgba(255,255,255,0.15)] hover:border-violet-500 transition-all">
									<div class="flex items-center gap-3 min-w-0">
										<div class="w-9 h-9 flex-shrink-0 flex items-center justify-center bg-[#FACC15] text-black border border-black font-black rounded-xl text-xs shadow-xs">
											<%= epNum %>
										</div>
										<h3 class="text-xs sm:text-sm font-bold text-black dark:text-white truncate group-hover:text-violet-500 transition-colors">
											<%= episode.title %>
										</h3>
									</div>
									<div class="w-8 h-8 flex-shrink-0 flex items-center justify-center rounded-full bg-black text-[#FACC15] border border-black group-hover:bg-violet-600 group-hover:text-white transition-all ml-2 shadow-xs">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 ml-0.5">
										  <path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd" />
										</svg>
									</div>
								</a>
							<% }) %>
						</div>
					<% } else { %>
						<div class="py-12 text-center text-neutral-500 font-bold bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-2xl">
							Belum ada episode tersedia saat ini.
						</div>
					<% } %>
				</section>

			</div>

			<!-- SIDEBAR AREA (Right) -->
			<aside class="lg:col-span-4 w-full flex flex-col gap-4 lg:sticky lg:top-24">
				
				<div class="w-full bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-3xl p-5 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,0.15)] flex flex-col gap-4">
					
					<div class="flex items-center justify-between pb-3 border-b-2 border-black dark:border-white/20">
						<div class="flex items-center gap-2">
							<span class="w-3 h-3 bg-amber-400 border border-black inline-block"></span>
							<h3 class="text-lg font-black uppercase tracking-tight text-black dark:text-white">
								Populer 🔥
							</h3>
						</div>
						<a href="/populer" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#F5F3EF] dark:bg-[#181920] hover:bg-[#FACC15] hover:text-black hover:border-black dark:hover:bg-[#FACC15] dark:hover:text-black dark:hover:border-black text-black dark:text-white border-2 border-black dark:border-white shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] dark:shadow-[1.5px_1.5px_0px_0px_rgba(255,255,255,0.25)] transition-colors font-black uppercase text-[10px] sm:text-xs tracking-wider cursor-pointer">
							<span>Lihat Semua</span>
							<span>→</span>
						</a>
					</div>

					<% if (Array.isArray(getDataSidebar) && getDataSidebar.length > 0) { %>
						<div class="flex flex-col gap-3">
							<% getDataSidebar.forEach((anime, idx) => { %>
								<a href="/anime/<%= anime.slug %>" class="neo-card group flex items-center gap-3 p-2.5 rounded-2xl bg-[#F5F3EF] dark:bg-[#121317] border border-black/20 dark:border-white/20 shadow-xs hover:border-black transition-all">
									<div class="w-12 h-16 flex-shrink-0 rounded-xl overflow-hidden border border-black dark:border-white/20 relative bg-neutral-200 dark:bg-neutral-800">
										<img src="<%= anime.image %>" alt="<%= anime.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform" onerror="this.onerror=null; this.src='/assets/images/no-img.jpg';">
										<div class="absolute top-0.5 left-0.5 w-4 h-4 rounded bg-black/80 text-[#FACC15] text-[9px] font-black flex items-center justify-center">
											<%= idx + 1 %>
										</div>
									</div>
									<div class="flex-1 min-w-0">
										<h4 class="text-xs font-bold text-black dark:text-white line-clamp-2 leading-snug group-hover:text-violet-600 dark:group-hover:text-[#FACC15] transition-colors">
											<%= anime.title %>
										</h4>
										<div class="flex items-center gap-2 mt-1 text-[10px] text-neutral-500 dark:text-neutral-400 font-semibold">
											<span><%= anime.type || 'TV' %></span>
											<span>•</span>
											<span class="text-amber-500"><%= anime.status || 'Ongoing' %></span>
										</div>
									</div>
								</a>
							<% }) %>
						</div>
					<% } else { %>
						<p class="text-neutral-500 text-xs text-center py-4 font-bold">Belum ada anime tersedia.</p>
					<% } %>

				</div>

			</aside>

		</div>

	</main>

    <%- include('partials/footer'); %>
    <%- include('partials/script'); %>

	<script>
		(function() {
			const container = document.getElementById('detailEpisodesContainer');
			const tabs = document.querySelectorAll('.chunk-tab');
			const searchInput = document.getElementById('epDetailSearch');
			const sortBtn = document.getElementById('btnDetailSort');
			const sortLabel = document.getElementById('sortDetailLabel');
			if (!container) return;

			const allCards = Array.from(container.querySelectorAll('.ep-card'));
			let activeStart = tabs.length > 0 ? parseFloat(tabs[0].getAttribute('data-start')) : 1;
			let activeEnd = tabs.length > 0 ? parseFloat(tabs[0].getAttribute('data-end')) : Infinity;
			let isAscending = true;

			function filterCards() {
				const query = searchInput ? searchInput.value.trim().toLowerCase() : '';

				allCards.forEach(card => {
					const ep = parseFloat(card.getAttribute('data-ep')) || 0;
					const title = card.getAttribute('data-title') || '';

					let matchRange = true;
					if (query === '' && activeStart !== 'all') {
						matchRange = ep >= activeStart && ep <= activeEnd;
					}

					let matchQuery = true;
					if (query) {
						matchQuery = title.includes(query) || ep.toString() === query || ep.toString().includes(query);
					}

					if (matchRange && matchQuery) {
						card.classList.remove('hidden');
					} else {
						card.classList.add('hidden');
					}
				});
			}

			// Handle range chunk tabs
			tabs.forEach(tab => {
				tab.addEventListener('click', () => {
					tabs.forEach(t => {
						t.className = 'chunk-tab flex-shrink-0 px-3 py-1.5 rounded-xl border-2 text-xs font-black transition-all bg-white dark:bg-[#181920] text-black dark:text-white border-black/20 dark:border-white/20 hover:border-black hover:bg-[#FACC15] hover:text-black';
					});
					tab.className = 'chunk-tab flex-shrink-0 px-3 py-1.5 rounded-xl border-2 text-xs font-black transition-all bg-violet-600 text-white border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]';

					const rawStart = tab.getAttribute('data-start');
					const rawEnd = tab.getAttribute('data-end');

					if (rawStart === 'all') {
						activeStart = 'all';
						activeEnd = 'all';
					} else {
						activeStart = parseFloat(rawStart);
						activeEnd = parseFloat(rawEnd);
					}

					if (searchInput) searchInput.value = '';
					filterCards();
				});
			});

			// Handle search
			if (searchInput) {
				searchInput.addEventListener('input', () => {
					filterCards();
				});
			}

			// Handle sort toggle (1->N vs N->1)
			if (sortBtn && sortLabel) {
				const totalEps = <%= episodes.length %>;
				sortBtn.addEventListener('click', () => {
					isAscending = !isAscending;
					sortLabel.textContent = isAscending ? `1 → ${totalEps}` : `${totalEps} → 1`;

					allCards.reverse();
					allCards.forEach(card => container.appendChild(card));
				});
			}

			// Handle mouse wheel horizontal scroll on tabs
			const rangeContainer = document.getElementById('rangeTabsContainer');
			if (rangeContainer) {
				rangeContainer.addEventListener('wheel', (e) => {
					if (e.deltaY !== 0) {
						e.preventDefault();
						rangeContainer.scrollLeft += e.deltaY;
					}
				}, { passive: false });
			}

			// Initial filter
			if (tabs.length > 0) {
				filterCards();
			}
		})();
	</script>
</body>
</html>
