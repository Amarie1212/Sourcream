<header class="sticky top-0 z-50 w-full px-4 sm:px-8 py-3 bg-[#EAE7DE]/90 dark:bg-[#111216]/90 backdrop-blur-md border-b-2 border-black/10 dark:border-white/10">
	<div class="max-w-7xl mx-auto flex items-center justify-between">
		
		<!-- Brand Logo -->
		<a href="/" class="flex items-center flex-shrink-0 group py-0.5" aria-label="Sourcream Anime Streaming">
			<img src="/assets/images/logo-anime-transparent.png" alt="Sourcream Anime Streaming" class="h-9 sm:h-11 md:h-12 w-auto object-contain hidden dark:block">
			<img src="/assets/images/logo-anime-light.png" alt="Sourcream Anime Streaming" class="h-9 sm:h-11 md:h-12 w-auto object-contain block dark:hidden">
		</a>

		<!-- Right Side Controls -->
		<div class="flex items-center gap-3">
			<!-- Search Trigger -->
			<div class="flex items-center gap-2">
				<form id="headerSearchForm" action="/pencarian" method="GET" class="header-search-form flex items-center overflow-visible opacity-0 -translate-x-2 pointer-events-none" aria-hidden="true">
					<div class="relative w-[min(58vw,280px)]">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-400">
							<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
						</svg>
						<input id="headerSearchInput" name="q" type="search" placeholder="Search anime" autocomplete="off" class="w-full rounded-full border-2 border-black bg-white py-2 pl-9 pr-3 text-xs font-semibold text-black outline-none transition focus:border-[#FACC15] dark:border-white/20 dark:bg-neutral-800 dark:text-white" tabindex="-1">
						<div id="headerSearchSuggestions" class="search-suggestions absolute left-0 right-0 top-full z-[60] mt-2 hidden overflow-hidden rounded-2xl border-2 border-black bg-white shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] dark:border-white/20 dark:bg-[#181920] dark:shadow-[3px_3px_0px_0px_rgba(255,255,255,0.15)]"></div>
					</div>
				</form>
				<button id="openSearchModal" type="button" aria-label="Open anime search" aria-expanded="false" aria-controls="headerSearchForm" class="p-2 rounded-full bg-white dark:bg-neutral-800 border-2 border-black dark:border-white/20 text-black dark:text-white hover:bg-[#FACC15] hover:text-black hover:border-black dark:hover:bg-[#FACC15] dark:hover:text-black dark:hover:border-black transition-colors shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] dark:shadow-[1.5px_1.5px_0px_0px_rgba(255,255,255,0.2)] cursor-pointer">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
						<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
					</svg>
				</button>
			</div>

			<!-- Theme Toggle Button -->
			<% if (typeof currentUser !== 'undefined' && currentUser) { %>
				<a href="/watchlist" class="header-account-button hidden sm:inline-flex items-center rounded-full border-2 border-black bg-[#F5F3EF] px-3 py-2 text-[10px] font-black uppercase text-black dark:border-white/20 dark:bg-[#181920] dark:text-white">Watchlist</a>
				<a href="/notifications" class="header-account-button hidden sm:inline-flex items-center rounded-full border-2 border-black bg-[#F5F3EF] px-3 py-2 text-[10px] font-black uppercase text-black dark:border-white/20 dark:bg-[#181920] dark:text-white">Notifikasi</a>
			<% } else { %>
				<a href="/login" class="hidden sm:inline-flex items-center rounded-full border-2 border-black bg-white px-3 py-2 text-[10px] font-black uppercase text-black shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] hover:bg-[#FACC15] hover:-translate-y-0.5 transition-all">Login</a>
			<% } %>

			<button id="theme-toggle" class="p-2 rounded-full bg-white dark:bg-neutral-800 border-2 border-black dark:border-white/20 text-black dark:text-white hover:bg-[#FACC15] hover:text-black hover:border-black dark:hover:bg-[#FACC15] dark:hover:text-black dark:hover:border-black transition-colors shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] dark:shadow-[1.5px_1.5px_0px_0px_rgba(255,255,255,0.2)] cursor-pointer">
				<svg id="light-icon" class="w-4 h-4 hidden dark:flex transition-all" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
				</svg>
				<svg id="dark-icon" class="w-4 h-4 flex dark:hidden transition-all" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
				</svg>
			</button>

		</div>
	</div>
</header>
