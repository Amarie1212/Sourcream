<header class="sticky top-0 z-50 w-full px-4 sm:px-8 py-3 bg-[#EAE7DE]/90 dark:bg-[#111216]/90 backdrop-blur-md border-b-2 border-black/10 dark:border-white/10 transition-colors duration-200">
	<div class="max-w-7xl mx-auto flex items-center justify-between">
		
		<!-- Brand Logo -->
		<a href="/komik" class="flex items-center gap-1.5 group transition-transform duration-200 hover:scale-105">
			<span class="text-2xl sm:text-3xl font-black tracking-tighter text-black dark:text-white uppercase">
				sourcream<span class="text-amber-500 font-normal">♥</span>
			</span>
			<span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase bg-[#FACC15] text-black border border-black hidden sm:inline-block">
				KOMIK
			</span>
		</a>

		<!-- Center Navigation Menu -->
		<nav class="hidden lg:flex items-center gap-6 bg-black text-white px-8 py-2 rounded-full shadow-lg border border-black/20 text-xs font-bold tracking-wider uppercase">
			<a href="/komik" class="hover:text-[#FACC15] transition-colors">
				Beranda
			</a>
			<a href="/komik/terbaru" class="hover:text-[#FACC15] transition-colors">
				Terbaru
			</a>
			<a href="/komik/terupdate" class="hover:text-[#FACC15] transition-colors">
				Terupdate
			</a>
			<a href="/komik/peringkat" class="hover:text-[#FACC15] transition-colors">
				Peringkat
			</a>
			<a href="/komik/acak" class="hover:text-[#FACC15] transition-colors">
				Acak
			</a>
			<a href="/komik/filter" class="hover:text-[#FACC15] transition-colors">
				Filter
			</a>
			<a href="/komik/alphabet" class="hover:text-[#FACC15] transition-colors">
				Abjad
			</a>
		</nav>

		<!-- Right Side Controls -->
		<div class="flex items-center gap-3">
			<!-- Search Trigger -->
			<button id="openSearchModal" class="p-2 rounded-full bg-white dark:bg-neutral-800 border-2 border-black dark:border-white/20 text-black dark:text-white hover:bg-[#FACC15] hover:text-black transition-all shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] dark:shadow-[2px_2px_0px_0px_rgba(255,255,255,0.2)]">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
					<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
				</svg>
			</button>

			<!-- Theme Toggle Button -->
			<button id="theme-toggle" class="p-2 rounded-full bg-white dark:bg-neutral-800 border-2 border-black dark:border-white/20 text-black dark:text-white hover:bg-[#FACC15] hover:text-black transition-all shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] dark:shadow-[2px_2px_0px_0px_rgba(255,255,255,0.2)]">
				<svg id="light-icon" class="w-4 h-4 hidden dark:flex transition-all" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
				</svg>
				<svg id="dark-icon" class="w-4 h-4 flex dark:hidden transition-all" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
				</svg>
			</button>

			<!-- Action Pill (Nonton Anime) -->
			<a href="/" class="hidden sm:inline-flex items-center gap-1.5 px-5 py-2 rounded-full font-extrabold text-xs tracking-wider uppercase bg-white dark:bg-neutral-900 text-black dark:text-white border-2 border-black dark:border-white hover:bg-black hover:text-white dark:hover:bg-[#FACC15] dark:hover:text-black transition-all shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] dark:shadow-[2px_2px_0px_0px_rgba(255,255,255,0.4)]">
				<span>Nonton Anime</span>
				<span class="text-sm">→</span>
			</a>

			<!-- Mobile Menu Toggle -->
			<button id="menuBtnMenu" class="lg:hidden p-2 rounded-xl bg-white dark:bg-neutral-800 border-2 border-black dark:border-white/20 text-black dark:text-white shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
				  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
				</svg>
			</button>
		</div>
	</div>
</header>