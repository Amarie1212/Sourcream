<!DOCTYPE html>
<html lang="id">
<head>
	<title><%= site_title %></title>
	<meta name="description" content="<%= site_desc %>">
	<meta name="keywords" content="<%= site_keyword %>">
	<meta property="og:title" content="<%= site_title %>">
	<meta property="og:description" content="<%= site_desc %>">
	<meta property="og:url" content="https://<%= site_url %>">
	<meta property="og:image" content="https://<%= site_url %>/assets/images/og.png">
	<%- include('partials/head'); %>
	<style>
		.neo-card {
			transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		}
		.neo-card:hover {
			transform: translateY(-4px);
			box-shadow: 5px 5px 0px 0px rgba(0, 0, 0, 1);
		}
		.dark .neo-card:hover {
			box-shadow: 5px 5px 0px 0px rgba(250, 204, 21, 0.35);
		}
		.slider-track::-webkit-scrollbar {
			display: none;
		}
	</style>
</head>
<body class="bg-[#EAE7DE] dark:bg-[#111216] text-black dark:text-white min-h-screen flex flex-col font-sans">
	<%- include('partials/header-komik'); %>
		
	<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 md:py-8 flex flex-col gap-8 md:gap-10">

		<!-- 1. HERO SPOTLIGHT SLIDER -->
		<% const heroItems = (data.popularManga && data.popularManga.length > 0) ? data.popularManga : (data.latestChapters || []); %>
		<% if (heroItems.length > 0) { %>
		<section class="w-full relative rounded-3xl overflow-hidden border-2 border-black/30 dark:border-white/20 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] dark:shadow-[6px_6px_0px_0px_rgba(255,255,255,0.15)] bg-[#111216] group select-none">
			<div id="heroSlider" class="relative w-full h-[340px] sm:h-[400px] md:h-[440px]">
				<% heroItems.slice(0, 6).forEach((item, idx) => { %>
					<div class="hero-slide absolute inset-0 transition-opacity duration-700 ease-in-out <%= idx === 0 ? 'opacity-100 z-10 pointer-events-auto' : 'opacity-0 z-0 pointer-events-none' %>" data-slide-index="<%= idx %>">
						<img src="<%= item.image %>" alt="<%= item.title %>" class="w-full h-full object-cover object-center transform scale-105 group-hover:scale-100 transition-transform duration-1000" onerror="this.onerror=null; this.src='/assets/images/no-img.jpg';">
						
						<div class="absolute inset-0 bg-gradient-to-r from-black/95 via-black/70 to-transparent"></div>
						<div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
						<div class="absolute inset-0 bg-black/20"></div>

						<div class="absolute inset-0 flex flex-col justify-end px-6 sm:px-10 pb-12 pt-6 max-w-3xl z-20 gap-2.5">
							<div class="flex items-center gap-2">
								<span class="px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase bg-[#FACC15] text-black border border-black shadow-xs">
									★ SPOTLIGHT KOMIK #<%= idx + 1 %>
								</span>
								<span class="px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase bg-white/20 text-white backdrop-blur-xs">
									<%= item.type || 'MANGA' %>
								</span>
								<span class="px-2.5 py-0.5 rounded-md text-[10px] font-bold bg-amber-500 text-black">
										<%= item.latestChapter ? item.latestChapter.replace(/^[\s\S]*?Updated:\s*/i, '') : 'Latest Chapters' %>
								</span>
							</div>

							<h1 class="text-2xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight text-white leading-tight drop-shadow-md line-clamp-2">
								<%= item.title %>
							</h1>

							<p class="text-xs sm:text-sm text-neutral-300 line-clamp-2 leading-relaxed max-w-2xl hidden sm:block">
								<%= item.synopsis || 'Read komik manga dan manhwa seru ini secara gratis di Sourcream.' %>
							</p>

							<div class="flex items-center gap-3 pt-2">
								<a href="/komik/detail/<%= item.slug %>" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#FACC15] hover:bg-white text-black border-2 border-black font-black text-xs sm:text-sm uppercase tracking-wider shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all cursor-pointer">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
									  <path d="M11.25 4.533A9.707 9.707 0 0 0 6 3a9.735 9.735 0 0 0-3.25.555.75.75 0 0 0-.5.707v14.25a.75.75 0 0 0 1 .707A8.237 8.237 0 0 1 6 18.75c1.995 0 3.823.707 5.25 1.886V4.533ZM12.75 20.636A8.214 8.214 0 0 1 18 18.75c.966 0 1.89.166 2.75.47a.75.75 0 0 0 1-.708V4.262a.75.75 0 0 0-.5-.707A9.735 9.735 0 0 0 18 3a9.707 9.707 0 0 0-5.25 1.533v16.103Z" />
									</svg>
									<span>READ NOW</span>
								</a>
							</div>
						</div>
					</div>
				<% }); %>

				<!-- Slider Prev/Next Controls -->
				<button id="heroPrevBtn" aria-label="Slide sebelumnya" class="absolute left-3 top-1/2 -translate-y-1/2 z-30 w-9 h-9 rounded-full bg-black/60 hover:bg-[#FACC15] hover:text-black text-white border border-white/20 flex items-center justify-center transition-all cursor-pointer backdrop-blur-xs">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
				</button>
				<button id="heroNextBtn" aria-label="Slide berikutnya" class="absolute right-3 top-1/2 -translate-y-1/2 z-30 w-9 h-9 rounded-full bg-black/60 hover:bg-[#FACC15] hover:text-black text-white border border-white/20 flex items-center justify-center transition-all cursor-pointer backdrop-blur-xs">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
				</button>

				<!-- Slider Dots -->
				<div class="absolute bottom-3 right-5 z-30 flex items-center gap-1.5 bg-black/50 px-3 py-1.5 rounded-full backdrop-blur-xs border border-white/20">
					<% heroItems.slice(0, 6).forEach((_, idx) => { %>
						<button class="hero-dot w-2 h-2 rounded-full transition-all <%= idx === 0 ? 'w-5 bg-[#FACC15]' : 'bg-white/40' %>" data-slide="<%= idx %>" aria-label="Go to slide <%= idx + 1 %>"></button>
					<% }); %>
				</div>
			</div>
		</section>
		<% } %>

		<!-- SECTION 1: CHAPTER TERBARU 📖 -->
		<section class="w-full flex flex-col gap-3">
			<div class="flex items-center justify-between pb-2 border-b-2 border-black dark:border-white/20 gap-2">
				<div class="flex items-center gap-2 min-w-0">
					<span class="w-3.5 h-3.5 bg-amber-400 border border-black inline-block flex-shrink-0"></span>
					<h2 class="text-base sm:text-xl md:text-2xl font-black uppercase tracking-tight text-black dark:text-white truncate">
						Latest Chapters 📖
					</h2>
				</div>
				<a href="/komik/terbaru?order=update" class="flex-shrink-0 whitespace-nowrap inline-flex items-center gap-1 sm:gap-1.5 px-3 sm:px-4 py-1 sm:py-1.5 rounded-full bg-[#F5F3EF] dark:bg-[#181920] hover:bg-[#FACC15] hover:text-black hover:border-black dark:hover:bg-[#FACC15] dark:hover:text-black dark:hover:border-black text-black dark:text-white border-2 border-black dark:border-white shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] dark:shadow-[1.5px_1.5px_0px_0px_rgba(255,255,255,0.25)] transition-colors font-black uppercase text-[10px] sm:text-xs tracking-wider cursor-pointer">
					<span>View All</span>
					<span>→</span>
				</a>
			</div>

			<!-- NETFLIX-STYLE SLIDER CONTAINER -->
			<div class="relative group/slider w-full">
				<button type="button" aria-label="Geser ke kiri" class="slider-btn-prev absolute left-0 top-1/2 -translate-y-1/2 -translate-x-2 sm:-translate-x-3 z-20 w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-[#FACC15] text-black border-2 border-black flex items-center justify-center shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:scale-110 active:scale-95 transition-all opacity-0 group-hover/slider:opacity-100 disabled:opacity-0 cursor-pointer">
					<svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
				</button>

				<div class="slider-track flex gap-3 sm:gap-4 overflow-x-auto scroll-smooth py-2 px-1 select-none" style="scrollbar-width: none; -ms-overflow-style: none;">
					<% if (data.latestChapters && data.latestChapters.length > 0) { %>
						<% data.latestChapters.slice(0, 10).forEach(item => { %>
							<div class="flex-shrink-0 w-[140px] xs:w-[155px] sm:w-[175px] md:w-[195px] lg:w-[210px]">
								<a href="/komik/detail/<%= item.slug %>" class="neo-card flex flex-col h-full bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] dark:shadow-[3px_3px_0px_0px_rgba(255,255,255,0.15)] group relative">
									<div class="relative aspect-[3/4] w-full overflow-hidden bg-neutral-200 dark:bg-neutral-800">
										<img class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300" src="<%= item.image %>" alt="<%= item.title %>" onerror="this.onerror=null; this.src='/assets/images/no-img.jpg';">
										<div class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-black text-[#FACC15] text-[10px] font-mono font-bold uppercase border border-black/50 backdrop-blur-xs shadow-xs">
											<%= item.type || 'MANGA' %>
										</div>
										<div class="absolute top-2 right-2 px-2 py-0.5 rounded-md bg-amber-400 text-black text-[10px] font-mono font-bold uppercase border border-black/50 shadow-xs">
														<%= item.latestChapter ? item.latestChapter.replace(/^[\s\S]*?Updated:\s*/i, '') : 'Up' %>
										</div>
										<div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-center">
											<div class="w-10 h-10 rounded-full bg-[#FACC15] text-black border-2 border-black flex items-center justify-center shadow-md transform scale-75 group-hover:scale-100 transition-transform">
												<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 ml-0.5"><path d="M11.25 4.533A9.707 9.707 0 0 0 6 3a9.735 9.735 0 0 0-3.25.555.75.75 0 0 0-.5.707v14.25a.75.75 0 0 0 1 .707A8.237 8.237 0 0 1 6 18.75c1.995 0 3.823.707 5.25 1.886V4.533ZM12.75 20.636A8.214 8.214 0 0 1 18 18.75c.966 0 1.89.166 2.75.47a.75.75 0 0 0 1-.708V4.262a.75.75 0 0 0-.5-.707A9.735 9.735 0 0 0 18 3a9.707 9.707 0 0 0-5.25 1.533v16.103Z" /></svg>
											</div>
										</div>
									</div>
									<div class="p-2.5 sm:p-3 flex-1 flex flex-col justify-between bg-white dark:bg-[#181920] border-t-2 border-black dark:border-white/10">
										<h3 class="text-xs font-bold text-black dark:text-white line-clamp-2 leading-snug group-hover:text-indigo-600 dark:group-hover:text-[#FACC15] transition-colors">
											<%= item.title %>
										</h3>
										<div class="flex items-center justify-between mt-2 pt-2 border-t border-dashed border-neutral-200 dark:border-neutral-800 text-[10px] text-neutral-500 dark:text-neutral-400 font-semibold">
											<span><%= item.status || 'Ongoing' %></span>
											<span class="text-black dark:text-white font-bold">Read →</span>
										</div>
									</div>
								</a>
							</div>
						<% }); %>
					<% } else { %>
						<div class="py-8 text-neutral-500 font-bold text-sm">No latest chapters available.</div>
					<% } %>
				</div>

				<button type="button" aria-label="Geser ke kanan" class="slider-btn-next absolute right-0 top-1/2 -translate-y-1/2 translate-x-2 sm:translate-x-3 z-20 w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-[#FACC15] text-black border-2 border-black flex items-center justify-center shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:scale-110 active:scale-95 transition-all opacity-0 group-hover/slider:opacity-100 disabled:opacity-0 cursor-pointer">
					<svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
				</button>
			</div>
		</section>

		<!-- SECTION 2: KOMIK RILIS BARU ✨ -->
		<section class="w-full flex flex-col gap-3">
			<div class="flex items-center justify-between pb-2 border-b-2 border-black dark:border-white/20 gap-2">
				<div class="flex items-center gap-2 min-w-0">
					<span class="w-3.5 h-3.5 bg-emerald-400 border border-black inline-block flex-shrink-0"></span>
					<h2 class="text-base sm:text-xl md:text-2xl font-black uppercase tracking-tight text-black dark:text-white truncate">
						Comics New Release ✨
					</h2>
				</div>
				<a href="/komik/baru" class="flex-shrink-0 whitespace-nowrap inline-flex items-center gap-1 sm:gap-1.5 px-3 sm:px-4 py-1 sm:py-1.5 rounded-full bg-[#F5F3EF] dark:bg-[#181920] hover:bg-[#FACC15] hover:text-black hover:border-black dark:hover:bg-[#FACC15] dark:hover:text-black dark:hover:border-black text-black dark:text-white border-2 border-black dark:border-white shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] dark:shadow-[1.5px_1.5px_0px_0px_rgba(255,255,255,0.25)] transition-colors font-black uppercase text-[10px] sm:text-xs tracking-wider cursor-pointer">
					<span>View All</span>
					<span>→</span>
				</a>
			</div>

			<!-- NETFLIX-STYLE SLIDER CONTAINER -->
			<div class="relative group/slider w-full">
				<button type="button" aria-label="Geser ke kiri" class="slider-btn-prev absolute left-0 top-1/2 -translate-y-1/2 -translate-x-2 sm:-translate-x-3 z-20 w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-[#FACC15] text-black border-2 border-black flex items-center justify-center shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:scale-110 active:scale-95 transition-all opacity-0 group-hover/slider:opacity-100 disabled:opacity-0 cursor-pointer">
					<svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
				</button>

				<div class="slider-track flex gap-3 sm:gap-4 overflow-x-auto scroll-smooth py-2 px-1 select-none" style="scrollbar-width: none; -ms-overflow-style: none;">
					<% if (data.newManga && data.newManga.length > 0) { %>
						<% data.newManga.slice(0, 10).forEach(item => { %>
							<div class="flex-shrink-0 w-[140px] xs:w-[155px] sm:w-[175px] md:w-[195px] lg:w-[210px]">
								<a href="/komik/detail/<%= item.slug %>" class="neo-card flex flex-col h-full bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] dark:shadow-[3px_3px_0px_0px_rgba(255,255,255,0.15)] group relative">
									<div class="relative aspect-[3/4] w-full overflow-hidden bg-neutral-200 dark:bg-neutral-800">
										<img class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300" src="<%= item.image %>" alt="<%= item.title %>" onerror="this.onerror=null; this.src='/assets/images/no-img.jpg';">
										<div class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-emerald-500 text-black text-[10px] font-black uppercase shadow-xs">
											BARU
										</div>
										<div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-center">
											<div class="w-10 h-10 rounded-full bg-[#FACC15] text-black border-2 border-black flex items-center justify-center shadow-md transform scale-75 group-hover:scale-100 transition-transform">
												<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 ml-0.5"><path d="M11.25 4.533A9.707 9.707 0 0 0 6 3a9.735 9.735 0 0 0-3.25.555.75.75 0 0 0-.5.707v14.25a.75.75 0 0 0 1 .707A8.237 8.237 0 0 1 6 18.75c1.995 0 3.823.707 5.25 1.886V4.533ZM12.75 20.636A8.214 8.214 0 0 1 18 18.75c.966 0 1.89.166 2.75.47a.75.75 0 0 0 1-.708V4.262a.75.75 0 0 0-.5-.707A9.735 9.735 0 0 0 18 3a9.707 9.707 0 0 0-5.25 1.533v16.103Z" /></svg>
											</div>
										</div>
									</div>
									<div class="p-2.5 sm:p-3 flex-1 flex flex-col justify-between bg-white dark:bg-[#181920] border-t-2 border-black dark:border-white/10">
										<h3 class="text-xs font-bold text-black dark:text-white line-clamp-2 leading-snug group-hover:text-indigo-600 dark:group-hover:text-[#FACC15] transition-colors">
											<%= item.title %>
										</h3>
										<div class="flex items-center justify-between mt-2 pt-2 border-t border-dashed border-neutral-200 dark:border-neutral-800 text-[10px] text-neutral-500 dark:text-neutral-400 font-semibold">
											<span><%= item.type || 'MANGA' %></span>
											<span class="text-black dark:text-white font-bold">Read →</span>
										</div>
									</div>
								</a>
							</div>
						<% }); %>
					<% } else { %>
						<div class="py-8 text-neutral-500 font-bold text-sm">No new comics available.</div>
					<% } %>
				</div>

				<button type="button" aria-label="Geser ke kanan" class="slider-btn-next absolute right-0 top-1/2 -translate-y-1/2 translate-x-2 sm:translate-x-3 z-20 w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-[#FACC15] text-black border-2 border-black flex items-center justify-center shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:scale-110 active:scale-95 transition-all opacity-0 group-hover/slider:opacity-100 disabled:opacity-0 cursor-pointer">
					<svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
				</button>
			</div>
		</section>

		<!-- SECTION 3: KOMIK TERPOPULER 🔥 -->
		<section class="w-full flex flex-col gap-3">
			<div class="flex items-center justify-between pb-2 border-b-2 border-black dark:border-white/20 gap-2">
				<div class="flex items-center gap-2 min-w-0">
					<span class="w-3.5 h-3.5 bg-rose-500 border border-black inline-block flex-shrink-0"></span>
					<h2 class="text-base sm:text-xl md:text-2xl font-black uppercase tracking-tight text-black dark:text-white truncate">
						Popular Comics 🔥
					</h2>
				</div>
				<a href="/komik/populer" class="flex-shrink-0 whitespace-nowrap inline-flex items-center gap-1 sm:gap-1.5 px-3 sm:px-4 py-1 sm:py-1.5 rounded-full bg-[#F5F3EF] dark:bg-[#181920] hover:bg-[#FACC15] hover:text-black hover:border-black dark:hover:bg-[#FACC15] dark:hover:text-black dark:hover:border-black text-black dark:text-white border-2 border-black dark:border-white shadow-[1.5px_1.5px_0px_0px_rgba(0,0,0,1)] dark:shadow-[1.5px_1.5px_0px_0px_rgba(255,255,255,0.25)] transition-colors font-black uppercase text-[10px] sm:text-xs tracking-wider cursor-pointer">
					<span>View All</span>
					<span>→</span>
				</a>
			</div>

			<!-- NETFLIX-STYLE SLIDER CONTAINER -->
			<div class="relative group/slider w-full">
				<button type="button" aria-label="Geser ke kiri" class="slider-btn-prev absolute left-0 top-1/2 -translate-y-1/2 -translate-x-2 sm:-translate-x-3 z-20 w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-[#FACC15] text-black border-2 border-black flex items-center justify-center shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:scale-110 active:scale-95 transition-all opacity-0 group-hover/slider:opacity-100 disabled:opacity-0 cursor-pointer">
					<svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
				</button>

				<div class="slider-track flex gap-3 sm:gap-4 overflow-x-auto scroll-smooth py-2 px-1 select-none" style="scrollbar-width: none; -ms-overflow-style: none;">
					<% if (data.popularManga && data.popularManga.length > 0) { %>
						<% data.popularManga.slice(0, 10).forEach(item => { %>
							<div class="flex-shrink-0 w-[140px] xs:w-[155px] sm:w-[175px] md:w-[195px] lg:w-[210px]">
								<a href="/komik/detail/<%= item.slug %>" class="neo-card flex flex-col h-full bg-white dark:bg-[#181920] border-2 border-black dark:border-white/20 rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] dark:shadow-[3px_3px_0px_0px_rgba(255,255,255,0.15)] group relative">
									<div class="relative aspect-[3/4] w-full overflow-hidden bg-neutral-200 dark:bg-neutral-800">
										<img class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300" src="<%= item.image %>" alt="<%= item.title %>" onerror="this.onerror=null; this.src='/assets/images/no-img.jpg';">
										<div class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-rose-500 text-white text-[10px] font-black uppercase shadow-xs">
